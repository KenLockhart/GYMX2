# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Find these in the Supabase dashboard under Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# The address people use to reach the site. Links in account emails are built from this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
