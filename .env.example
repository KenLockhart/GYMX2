# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Find these in the Supabase dashboard under Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# The address people use to reach the site. Links in account emails are built from this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Supabase secret key, from the same page. Server only: never put NEXT_PUBLIC_ in front of it.
SUPABASE_SECRET_KEY=your-secret-key

# Video uploads and playback. Find these on the Stream page of the Cloudflare dashboard.
# The token only needs the "Stream: Edit" permission. The site runs without these, but videos won't work.
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_STREAM_TOKEN=your-stream-api-token
CLOUDFLARE_STREAM_CUSTOMER_CODE=your-customer-code

# Paid downloads in the Armory. Find these in the Stripe dashboard (Developers > API keys and Webhooks).
# Use sk_test_ keys to try it with test cards before taking real payments. The site runs without these,
# but paid items can't be bought.
STRIPE_SECRET_KEY=sk_test_your-secret-key
# The signing secret of the webhook pointed at https://YOUR-SITE/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Notification emails (new orders, shipped orders, messages, sessions). A Resend API key with
# "Sending access" for gymx2.com. The site runs without it, but sends no notification emails.
RESEND_API_KEY=re_your-sending-key

# Shows Stripe's payment form inside GYMX2 so buyers never leave the site. The publishable key
# (pk_test_ or pk_live_) from Stripe > Developers > API keys. It is safe to expose. Without it,
# buyers are sent to Stripe's own checkout page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
