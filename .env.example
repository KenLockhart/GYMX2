# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Find these in the Supabase dashboard under Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# The address people use to reach the site. Links in account emails are built from this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Supabase secret key, from the same page. Server only: never put NEXT_PUBLIC_ in front of it.
SUPABASE_SECRET_KEY=your-secret-key

# Video uploads and playback. Find these on the Stream page of the Cloudflare dashboard.
# The token only needs the "Stream: Edit" permission. The site runs without these, but videos won't work.
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_STREAM_TOKEN=your-stream-api-token
CLOUDFLARE_STREAM_CUSTOMER_CODE=your-customer-code
